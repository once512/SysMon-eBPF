# 只检查 BPF 宿主参数拒绝路径，错误应在加载内核程序前返回，不需要 root。
# Exercise argument rejection before any BPF loading or privileged operation.
function(expect_invalid)
    execute_process(COMMAND "${SECMON}" ${ARGV}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "2")
        message(FATAL_ERROR "${ARGV}: expected exit 2, got ${status}: ${output}${error}")
    endif()
endfunction()
expect_invalid(--unknown)
expect_invalid(--protect-file)
expect_invalid(--self-protect)
expect_invalid(--stop)
expect_invalid(--stop /unused --check)
expect_invalid(--self-protect /unused --self-protect /other)
expect_invalid(--check --protect-file /unused)
expect_invalid(--check --self-protect /unused)
expect_invalid(--check --run-for 1)
expect_invalid(--run-for)
foreach(value 0 3601 -1 +1 1s 1.5 99999999999999999999999999999)
    expect_invalid(--run-for "${value}")
endforeach()
set(paths)
foreach(index RANGE 1 257)
    list(APPEND paths --protect-file /unused)
endforeach()
expect_invalid(${paths})

expect_invalid(--policy)
expect_invalid(--reload)
expect_invalid(--reload /unused --check)
expect_invalid(--policy /a --policy /b)
expect_invalid(--check --policy /a)
expect_invalid(--policy /a --protect-file /b)

expect_invalid(--policy "")
expect_invalid(--policy relative.conf)

expect_invalid(--status)
expect_invalid(--status /unused --check)

# 单入口的模块选择和共用管理参数不得产生隐含优先级。
expect_invalid(--bpf-only --fanotify-only)
expect_invalid(--fanotify-only)
expect_invalid(--bpf-only --file /unused --decision deny)
expect_invalid(--control relative)
expect_invalid(--control /a --self-protect /b)
expect_invalid(--check --fanotify-only)
expect_invalid(--policy /a --file /unused --decision allow)

expect_invalid(--audit-permissions --audit-permissions)
expect_invalid(--audit-permissions --bpf-only)
expect_invalid(--check --audit-permissions)
