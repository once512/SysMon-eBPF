# 单服务查询工具的参数检查：错误在连接前返回。
function(expect_invalid)
    execute_process(COMMAND "${POLICYCTL}" ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "2")
        message(FATAL_ERROR "Expected invalid arguments: ${ARGV}: ${code} ${output}${error}")
    endif()
endfunction()
expect_invalid()
expect_invalid(--socket)
expect_invalid(--socket relative)
expect_invalid(--socket /unused --socket /other)
expect_invalid(--socket /unused --unknown 1)
expect_invalid(--bpf-socket /unused --fanotify-socket /unused)
foreach(value 0 -1 +1 1x 1.5 18446744073709551616)
    expect_invalid(--socket /unused --expect-revision "${value}")
endforeach()
