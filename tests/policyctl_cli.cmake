# 只读管理工具先校验路径、重复参数与 uint64 预期版本；参数错误不连接任何服务。
function(expect_invalid)
    execute_process(COMMAND "${POLICYCTL}" ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "2")
        message(FATAL_ERROR "Expected invalid arguments: ${ARGV}: ${code} ${output}${error}")
    endif()
endfunction()
expect_invalid()
expect_invalid(--bpf-socket)
expect_invalid(--bpf-socket /unused)
expect_invalid(--bpf-socket relative --fanotify-socket /unused)
expect_invalid(--bpf-socket /unused --fanotify-socket /unused --bpf-socket /other)
expect_invalid(--bpf-socket /unused --fanotify-socket /unused --unknown 1)
foreach(value 0 -1 +1 1x 1.5 18446744073709551616)
    expect_invalid(--bpf-socket /unused --fanotify-socket /unused --expect-revision "${value}")
endforeach()
