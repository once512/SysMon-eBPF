# 只检查 fanotify 参数和配置模式互斥，不能据此认定权限事件机制已获内核支持。
# These malformed arguments must fail before opening/marking any file.
function(expect_invalid)
    execute_process(COMMAND "${SECMON}" --fanotify-only ${ARGV}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${status}" STREQUAL "2")
        message(FATAL_ERROR "${ARGV}: expected exit 2, got ${status}: ${output}${error}")
    endif()
endfunction()
set(base --file /unused --decision allow --run-for 1)
expect_invalid()
expect_invalid(--file /unused --run-for 1)
expect_invalid(--file /unused --decision unknown --run-for 1)
expect_invalid(${base} --unknown value)
expect_invalid(${base} --file /other)
expect_invalid(${base} --decision deny)
expect_invalid(${base} --max-pending 1 --max-pending 2)
foreach(option --decision-delay-ms --request-timeout-ms --max-pending)
    expect_invalid(${base} ${option})
    foreach(value -1 +1 1.5 1s 99999999999999999999)
        expect_invalid(${base} ${option} ${value})
    endforeach()
endforeach()
expect_invalid(${base} --request-timeout-ms 0)
expect_invalid(${base} --request-timeout-ms 60001)
expect_invalid(${base} --decision-delay-ms 60001)
expect_invalid(${base} --max-pending 0)
expect_invalid(${base} --max-pending 4097)
expect_invalid(${base} --timeout-decision unknown)
expect_invalid(${base} --overload-decision unknown)

expect_invalid(${base} --event unknown)
expect_invalid(${base} --event open --event exec)

expect_invalid(${base} --analyzer /unused --deny-marker marker)
expect_invalid(--file /unused --run-for 1 --analyzer relative --deny-marker marker)
expect_invalid(--file /unused --run-for 1 --analyzer /unused)
expect_invalid(--file /unused --run-for 1 --analyzer /unused --deny-marker marker --decision-delay-ms 0)
expect_invalid(${base} --deny-marker marker)
expect_invalid(${base} --scan-limit-bytes 1)
expect_invalid(${base} --analyzer-error-decision deny)
expect_invalid(--file /unused --run-for 1 --analyzer /unused --deny-marker marker --scan-limit-bytes 0)
expect_invalid(--file /unused --run-for 1 --analyzer /unused --deny-marker marker --scan-limit-bytes 1048577)

expect_invalid(--policy)
expect_invalid(--policy relative --run-for 1)
expect_invalid(--policy /unused --run-for 1 --decision deny)
expect_invalid(--policy /unused --run-for 1 --file /unused)
expect_invalid(--policy /unused --run-for 1 --event open)
expect_invalid(--policy /unused --run-for 1 --max-pending 1)
expect_invalid(--policy /unused --run-for 1 --control relative)
expect_invalid(--reload)
expect_invalid(--reload /unused --run-for 1)
expect_invalid(--stop /unused --run-for 1)

expect_invalid(--status)
expect_invalid(--status /unused --run-for 1)
